<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= classroom.name %> — Assets</title>
  <link rel="stylesheet" href="/style.css"/>
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/" class="back-link">← All Classrooms</a>
      <span class="nav-icon">🏫</span>
      <span><%= classroom.name %></span>
    </div>
    <div class="nav-actions">
      <a href="/classroom/<%= classroom.id %>/asset/new" class="btn btn-primary">+ Add Asset</a>
      <a href="/classroom/<%= classroom.id %>/edit" class="btn btn-secondary">✏️ Edit Room</a>
    </div>
  </nav>

  <div class="container">

    <% if(isNew) { %>
      <div class="alert alert-success">✅ Asset added successfully!</div>
    <% } %>

    <!-- Classroom Header -->
    <div class="classroom-header-card">
      <div class="classroom-header-info">
        <h1><%= classroom.name %></h1>
        <div class="classroom-meta-row">
          <% if(classroom.building) { %><span class="meta-chip">🏢 <%= classroom.building %></span><% } %>
          <% if(classroom.floor) { %><span class="meta-chip">📐 Floor: <%= classroom.floor %></span><% } %>
          <span class="meta-chip">📦 <%= assets.length %> asset type<%= assets.length !== 1 ? 's' : '' %></span>
        </div>
        <% if(classroom.description) { %><p class="classroom-desc"><%= classroom.description %></p><% } %>
      </div>
      <div class="classroom-qr-block">
        <p class="qr-label">Classroom QR Code</p>
        <p class="qr-hint">Scan → opens this page on any device</p>
        <div class="qr-box-sm">
          <img src="<%= classroom.qr_path %>" alt="QR" class="qr-medium"/>
        </div>
        <a href="<%= classroom.qr_path %>" download="QR-<%= classroom.name %>.png" class="btn btn-secondary btn-sm mt-8">⬇️ Download QR</a>
      </div>
    </div>

    <!-- Assets Table -->
    <% if(assets.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📦</div>
        <h3>No assets added yet</h3>
        <p>Add chairs, tables, PCs, CPUs and other items in this classroom.</p>
        <a href="/classroom/<%= classroom.id %>/asset/new" class="btn btn-primary">+ Add First Asset</a>
      </div>
    <% } else { %>
      <div class="assets-table-wrap">
        <table class="assets-table">
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Type</th>
              <th>Quantity</th>
              <th>Condition</th>
              <th>Notes</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% assets.forEach(asset => { %>
              <tr>
                <td class="asset-name-cell"><strong><%= asset.name %></strong></td>
                <td><span class="type-badge type-<%= asset.type.toLowerCase().replace(/\s/g,'') %>"><%= asset.type %></span></td>
                <td><span class="qty-num"><%= asset.quantity %></span></td>
                <td><span class="condition-badge condition-<%= asset.condition_status.toLowerCase().replace(/ /g,'-') %>"><%= asset.condition_status %></span></td>
                <td class="notes-cell"><%= asset.description || '—' %></td>
                <td class="action-cell">
                  <a href="/asset/<%= asset.id %>/edit" class="btn btn-secondary btn-sm">✏️</a>
                  <form method="POST" action="/asset/<%= asset.id %>/delete" style="display:inline"
                        onsubmit="return confirm('Delete <%= asset.name %>?')">
                    <button type="submit" class="btn btn-danger btn-sm">🗑</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr class="total-row">
              <td colspan="2"><strong>Total Items</strong></td>
              <td><strong><%= assets.reduce((s,a)=>s+a.quantity,0) %></strong></td>
              <td colspan="3"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>
